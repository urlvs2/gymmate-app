# Copy to .env.local and fill in.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter — https://openrouter.ai/keys. SERVER ONLY, never NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Comma-separated = fallback chain, tried in order. GPT-5.6 (luna) runs both the
# conversation and the program on a free-tier key; with purchased credits you can
# promote these to openai/gpt-5.4 for even richer plans.
OPENROUTER_MODEL=openai/gpt-5.6-luna,openai/gpt-oss-120b:free
OPENROUTER_MODEL_PLAN=openai/gpt-5.6-luna,openai/gpt-oss-120b:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=GymMate
