# Copy to .env.local and fill in.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter — https://openrouter.ai/keys. SERVER ONLY, never NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Comma-separated = fallback chain, tried in order.
OPENROUTER_MODEL=openai/gpt-oss-20b:free,google/gemma-4-31b-it:free
OPENROUTER_MODEL_PLAN=nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-20b:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=GymMate
