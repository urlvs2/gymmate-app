# Copy to .env.local and fill in.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter — https://openrouter.ai/keys. SERVER ONLY, never NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Comma-separated = fallback chain, tried in order. GPT-5.6 (luna) is the primary
# model for both; with credit on the key it serves the whole-program request in
# ~1-2s. qwen3.7-flash is only a safety net — the chain reaches it only if luna
# actually fails, so it is never used while luna is working.
OPENROUTER_MODEL=openai/gpt-5.6-luna,qwen/qwen3.7-flash
OPENROUTER_MODEL_PLAN=openai/gpt-5.6-luna,qwen/qwen3.7-flash
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=GymMate
