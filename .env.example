# Copy to .env.local and fill in.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter — https://openrouter.ai/keys. SERVER ONLY, never NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Comma-separated = fallback chain, tried in order. GPT-5.6 (luna) is best, but
# on a free-tier key with no credits it can only afford a short reply and 402s
# on the larger plan request — so cheaper models follow it that DO fit that
# request within the free balance and answer in seconds. Add credits at
# openrouter.ai and luna serves everything.
OPENROUTER_MODEL=openai/gpt-5.6-luna,qwen/qwen3.7-flash,inclusionai/ling-2.6-flash
OPENROUTER_MODEL_PLAN=openai/gpt-5.6-luna,qwen/qwen3.7-flash,mistralai/mistral-nemo
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=GymMate
